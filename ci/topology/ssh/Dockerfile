# V-G03 — a jump host for the SSH tunnel tests (v2.1 §21.5).
#
# Built from the **same digest** the compatibility manifest already pins for redis 7.4, which
# is a Debian bookworm image. Reusing it rather than adding a base image means one fewer thing
# in the supply chain sitting in the middle of a credential path -- and the digest is one the
# repository already records and re-verifies.
#
# The key pair is generated by up.sh and the public half is copied in, so the test has a
# known-hosts entry to verify against: the point of these tests is that host key checking is
# ON, which needs a host key known in advance.
FROM redis@sha256:71da9275c5f3fcb97d0fa0c8c5b36cc995327265420f17a04bfd544f458059f7

RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends openssh-server \
 && rm -rf /var/lib/apt/lists/* \
 && mkdir -p /run/sshd \
 && (useradd -m -s /usr/sbin/nologin penguin || true) \
 && mkdir -p /home/penguin/.ssh

# Forward-only: no shell, no command execution. A bastion that can run commands is a bastion
# whose compromise is worse than the tunnel it carries.
RUN printf '%s\n' \
    'PermitRootLogin no' \
    'PasswordAuthentication no' \
    'PubkeyAuthentication yes' \
    'AllowTcpForwarding yes' \
    'PermitOpen any' \
    'GatewayPorts no' \
    'X11Forwarding no' \
    'AllowAgentForwarding no' \
    'Match User penguin' \
    '  ForceCommand /usr/sbin/nologin' \
    > /etc/ssh/sshd_config.d/penguin.conf

COPY authorized_keys /home/penguin/.ssh/authorized_keys
RUN chown -R penguin:penguin /home/penguin/.ssh \
 && chmod 700 /home/penguin/.ssh \
 && chmod 600 /home/penguin/.ssh/authorized_keys \
 && ssh-keygen -A

EXPOSE 22
ENTRYPOINT []
CMD ["/usr/sbin/sshd", "-D", "-e"]
